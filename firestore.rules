rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // ROLES  ->  staff/{uid}
    //   { role: "admin" }        : full access, can use admin.html
    //   { role: "interviewer" }  : read-only, uses interview.html
    //
    // An account with NO staff doc is treated as admin, so existing
    // accounts are not locked out when these rules are published.
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function hasStaffDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (!hasStaffDoc() || staffDoc().data.role == 'admin');
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'department', 'position'])
        && data.name is string && data.name.size() > 0 && data.name.size() < 200
        && data.email is string && data.email.size() > 0 && data.email.size() < 200
        && data.phone is string && data.phone.size() > 0 && data.phone.size() < 50
        && data.department is string
        && data.position is string
        && data.to is list;
    }

    // Staff roles.
    // read  : your own doc (the site checks your role), or any doc if admin
    // write : admin only (managed from admin.html -> Settings tab)
    match /staff/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Job applications.
    // create        : anyone (public application form, no login)
    // read          : any signed-in account (admin + interviewer)
    // update/delete : admin only (interviewers cannot edit or delete)
    match /applications/{applicationId} {
      allow create: if isValidApplication(request.resource.data);
      allow read: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Departments (public position catalogue).
    match /departments/{deptId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Branches.
    match /branches/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings (HR notification emails, application form structure, etc).
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Block everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
